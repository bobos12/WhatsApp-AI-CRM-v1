# ── Backend configuration ────────────────────────────────────────────────────
# Copy to .env for local dev. In production these are supplied per-tenant by
# docker-compose.tenant.yml (see ONBOARDING.md).

# Required
DATABASE_URL=postgresql://postgres:password@localhost:5433/whatsapp_system
JWT_SECRET=use-a-long-random-string-min-32-chars-in-production
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── WhatsApp transport ────────────────────────────────────────────────────────
# DEPRECATED. Which transport a tenant sends through is now a per-tenant setting
# (Settings → WhatsApp), stored on WhatsAppChannel, so one deployment can serve
# Cloud API and Baileys customers at once. This value is no longer read.
WHATSAPP_PROVIDER=baileys
# Per-instance WhatsApp auth folder (lets multiple instances coexist on one host)
WHATSAPP_SESSION_PATH=auth_info_baileys
# true = skip the 15-day new-number warm-up ramp (set when connecting an
# already-trusted, long-lived number). Default false = safe ramp for new numbers.
WHATSAPP_ESTABLISHED=false
# Warm-up ENFORCEMENT is opt-in. Off by default so the dashboard can show warm-up
# data without ever throttling an existing number. Set true ONLY for a genuinely
# fresh number you want capped through the 15-day ramp.
WARMUP_ENFORCE=false

# Developer super-account — provisioned/kept as SUPER_ADMIN on every boot.
# Leave blank to disable. In production the password must be >= 12 chars.
DEV_SUPERUSER_EMAIL=
DEV_SUPERUSER_PASSWORD=
DEV_SUPERUSER_NAME=Developer

# Business owner — created (create-only) on first boot of a fresh instance.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Redis — REQUIRED in production (broadcasts + automation-flow queues).
# In the Docker stack this points at the bundled `redis` service
# (redis://redis:6379). Locally, leave blank to fall back to localhost.
REDIS_URL=

# ── Media storage ─────────────────────────────────────────────────────────────
# In production you must EITHER configure S3-compatible storage below, OR opt into
# durable local-disk storage. For a single self-hosted instance, local storage on
# a persistent volume is perfectly fine (the Docker stack sets this to true):
ALLOW_LOCAL_STORAGE=false
# S3 / Cloudflare R2 / MinIO. When S3_BUCKET is set, uploads go to object storage
# instead of local disk (recommended for ephemeral/cloud hosts). Leave blank for
# local storage.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# Optional AI bot (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# ── WhatsApp Business Cloud API (the official, sellable transport) ────────────
# Per-tenant credentials (Phone Number ID, WABA ID, access token, app secret) are
# entered in the app under Settings → WhatsApp and stored encrypted. Only the
# platform-wide values below live here.

# REQUIRED before any tenant can save Cloud API credentials. Encrypts their Meta
# access tokens at rest (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this without re-encrypting makes stored tokens unreadable and every
# affected tenant has to re-enter theirs — so treat it as permanent.
CREDENTIAL_ENCRYPTION_KEY=

# The shared string Meta echoes back during the webhook GET handshake. Any random
# value; tenants paste the same one into their Meta App. Not a security boundary
# — the X-Hub-Signature-256 check is.
META_WEBHOOK_VERIFY_TOKEN=

# Fallback app secret for verifying webhook signatures, used when a tenant is on
# the PLATFORM's Meta App rather than their own. Under manual onboarding each
# tenant supplies their own app secret in Settings and this is not needed.
META_APP_SECRET=

# Public origin of THIS API, used to show tenants the webhook callback URL to
# paste into their Meta App. e.g. https://api.yourcrm.com
PUBLIC_API_URL=

# Graph API version to call. Pinned deliberately — Meta ships breaking changes on
# its own schedule and an unpinned integration breaks without a deploy.
META_GRAPH_VERSION=v21.0
